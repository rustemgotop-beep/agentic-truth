# ==============================================================================
# КОНФИГУРАЦИЯ СЕТИ И КЛЮЧЕЙ ДЛЯ AGENTIC TRUTH (GigaChat Only)
# ==============================================================================

# Токен авторизации GigaChat (Сбер)
# Получить можно в личном кабинете https://developers.sber.ru/studio/workspace.
# Авторизационные данные (Client ID + Client Secret в base64 или готовый ключ):
GIGACHAT_CREDENTIALS=your_gigachat_credentials_base64_here

# Область действия API: GIGACHAT_API_PERS (для физлиц) или GIGACHAT_API_CORP (для юрлиц)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Название модели GigaChat: GigaChat, GigaChat-Plus, GigaChat-Pro, GigaChat-Max
GIGACHAT_MODEL=GigaChat

# (Опционально) Поисковый API Tavily для внешнего поиска теорем
TAVILY_API_KEY=tvly-your_tavily_key_here
